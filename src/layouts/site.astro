---
import "../styles/global.css";
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
}

const {
  title = "Ikhwan Ramadhan | Junior Fullstack Web Engineer",
  description = "Portofolio Ikhwan Ramadhan, Junior Fullstack Web Engineer dengan kekuatan utama di Next.js, REST API, testing, CI/CD, deployment serverless, dan Git workflow tim.",
  canonicalPath = Astro.url.pathname,
} = Astro.props;
const siteUrl =
  Astro.site?.toString().replace(/\/$/, "") ?? "https://ikhwann.my.id";
const canonicalUrl = new URL(canonicalPath, Astro.site ?? Astro.url).toString();
const ogImageUrl = `${siteUrl}/og.png`;

// ── JSON-LD: Person Schema ──
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Ikhwan Ramadhan",
  jobTitle: "Junior Fullstack Web Engineer",
  url: `${siteUrl}/`,
  image: `${siteUrl}/profile.png`,
  email: "mailto:ikhwn.rdn@gmail.com",
  address: {
    "@type": "PostalAddress",
    addressCountry: "ID",
  },
  sameAs: ["https://github.com/IngsR", "https://www.linkedin.com/in/ikhwn-rdn"],
  knowsAbout: [
    "Fullstack Web Engineering",
    "Next.js",
    "REST API",
    "React.js",
    "TypeScript",
    "JavaScript",
    "Server-Side Rendering (SSR)",
    "Testing",
    "OWASP Top 10",
    "CI/CD",
    "Serverless Deployment",
    "Git Workflow",
    "Static Site Generation (SSG)",
    "Incremental Static Regeneration (ISR)",
    "Open Graph Optimization",
    "Tailwind CSS",
    "shadcn/ui",
    "Astro",
    "Vite",
  ],
};

// ── JSON-LD: WebSite Schema ──
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Profile Ikhwan Ramadhan",
  url: `${siteUrl}/`,
  description,
  publisher: { "@type": "Person", name: "Ikhwan Ramadhan" },
  inLanguage: "id-ID",
};

// ── JSON-LD: WebPage Schema (per-page) ──
const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: title,
  description,
  url: canonicalUrl,
  isPartOf: {
    "@type": "WebSite",
    name: "Profile Ikhwan Ramadhan",
    url: `${siteUrl}/`,
  },
  inLanguage: "id-ID",
  author: { "@type": "Person", name: "Ikhwan Ramadhan" },
  dateModified: new Date().toISOString(),
};

// ── JSON-LD: BreadcrumbList Schema ──
const pathSegments = canonicalPath
  .replace(/^\/|\/$/g, "")
  .split("/")
  .filter(Boolean);
const breadcrumbItems = [
  {
    "@type": "ListItem",
    position: 1,
    name: "Beranda",
    item: `${siteUrl}/`,
  },
  ...pathSegments.map((segment, index) => ({
    "@type": "ListItem",
    position: index + 2,
    name: segment.charAt(0).toUpperCase() + segment.slice(1),
    // trailingSlash: "never" → URL breadcrumb tanpa trailing slash
    item: `${siteUrl}/${pathSegments.slice(0, index + 1).join("/")}`,
  })),
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbItems,
};
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Ikhwan Ramadhan" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/logo.ico" />

    <!-- Theme Initializer (Default: Light Mode) -->
    <script is:inline>
      try {
        const theme = localStorage.getItem("portfolio_theme");
        if (theme === "dark") {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
      } catch (e) {
        document.documentElement.classList.remove("dark");
      }
    </script>
    <!-- Language Alternate -->
    <link rel="alternate" hreflang="id" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Ikhwan Ramadhan - Junior Fullstack Web Engineer"
    />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:site_name" content="Ikhwan Ramadhan" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta
      name="twitter:image:alt"
      content="Ikhwan Ramadhan - Junior Fullstack Web Engineer"
    />

    <!-- Structured Data (JSON-LD) -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(personSchema)}
    ></script>
    <script
      type="application/ld+json"
      set:html={JSON.stringify(websiteSchema)}
    ></script>
    <script
      type="application/ld+json"
      set:html={JSON.stringify(webPageSchema)}
    ></script>
    <script
      type="application/ld+json"
      set:html={JSON.stringify(breadcrumbSchema)}
    ></script>
    <!-- Search Engine Verification -->
    <meta
      name="google-site-verification"
      content="6TM9P7buGWO2wS0SqofqquuWDfvadyhMq56ivQnUQRE"
    />
    <meta name="msvalidate.01" content="92D58529971734088AE431B5DA99146C" />

    <!-- Google Fonts (non-blocking async load to eliminate render-blocking) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Abril+Fatface&family=Bricolage+Grotesque:opsz,wght@12..96,200..800&family=Caveat:wght@500;600;700&family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=Instrument+Sans:wght@400;500;600;700&family=Nunito:ital,wght@0,400..800;1,400..800&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Abril+Fatface&family=Bricolage+Grotesque:opsz,wght@12..96,200..800&family=Caveat:wght@500;600;700&family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=Instrument+Sans:wght@400;500;600;700&family=Nunito:ital,wght@0,400..800;1,400..800&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600&display=swap"
        rel="stylesheet"
      />
    </noscript>
  </head>
  <body>
    <slot />
    <Analytics />
    <SpeedInsights />
  </body>
</html>
